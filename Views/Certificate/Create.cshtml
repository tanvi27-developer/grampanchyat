@model GrampanchayatSystem.Models.Certificate
@{
    ViewData["Title"] = "Request Certificate";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h3 class="mb-3">Online Certificate Request</h3>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="CitizenName" class="form-label">Citizen Name</label>
                        <input asp-for="CitizenName" class="form-control" placeholder="Citizen full name" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Type" class="form-label">Certificate Type</label>
                        <select asp-for="Type" class="form-select">
                            <option value="Birth">Birth</option>
                            <option value="Death">Death</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Details" class="form-label">Details</label>
                        <input asp-for="Details" class="form-control" placeholder="Enter certificate details" />
                    </div>

                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-controller="Certificate" asp-action="Index" class="btn btn-outline-secondary ms-2">Back</a>
                </form>
            </div>
        </div>
    </div>
</div>