@model List<GrampanchayatSystem.Models.Certificate>

@{
    ViewData["Title"] = "Certificates";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Birth/Death Certificates</h2>
    <a asp-controller="Certificate" asp-action="Create" class="btn btn-primary">Request Certificate</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Citizen Name</th>
                    <th>Certificate Type</th>
                    <th>Details</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No certificates available.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CitizenName</td>
                            <td>
                                @if (item.Type == "Birth")
                                {
                                    <span class="badge bg-success">Birth</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Death</span>
                                }
                            </td>
                            <td>@item.Details</td>
                            <td>
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                @if (item.PaymentStatus == "Paid")
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unpaid</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @if (User.IsInRole("Admin") && item.Status == "Pending")
                                {
                                    <form asp-action="Approve" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                    <form asp-action="Reject" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                    </form>
                                }

                                @if (item.PaymentStatus != "Paid")
                                {
                                    <form asp-action="Pay" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary">Pay</button>
                                    </form>
                                }

                                @if (item.Status == "Approved" && item.PaymentStatus == "Paid")
                                {
                                    <a asp-action="DownloadPdf" asp-route-id="@item.Id" class="btn btn-sm btn-dark">Download PDF</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>