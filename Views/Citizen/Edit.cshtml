@model GrampanchayatSystem.Models.Citizen

<h2>Edit Citizen</h2>

<form method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    <label>Full Name</label>
    <input type="text" name="FullName" value="@Model.FullName" />
    <br />

    <label>Address</label>
    <input type="text" name="Address" value="@Model.Address" />
    <br />

    <label>Mobile</label>
    <input type="text" name="Mobile" value="@Model.Mobile" />
    <br />

    <button type="submit">Update</button>

</form>