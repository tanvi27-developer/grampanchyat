@{
    ViewData["Title"] = "Village Gallery";
}

<div class="container py-4">

    <h2 class="text-center text-primary fw-bold mb-4">
        🏞 Village Gallery
    </h2>

    <p class="text-center text-muted mb-4">
        Explore beautiful places, temples, rivers and development of our village.
    </p>

    <div id="villageCarousel"
         class="carousel slide carousel-fade shadow-lg rounded overflow-hidden"
         data-bs-ride="carousel"
         data-bs-interval="2500">

        <!-- Indicators -->
        <div class="carousel-indicators">

            <button type="button"
                    data-bs-target="#villageCarousel"
                    data-bs-slide-to="0"
                    class="active">
            </button>

            <button type="button"
                    data-bs-target="#villageCarousel"
                    data-bs-slide-to="1">
            </button>

            <button type="button"
                    data-bs-target="#villageCarousel"
                    data-bs-slide-to="2">
            </button>

            <button type="button"
                    data-bs-target="#villageCarousel"
                    data-bs-slide-to="3">
            </button>

            <button type="button"
                    data-bs-target="#villageCarousel"
                    data-bs-slide-to="4">
            </button>

            <button type="button"
                    data-bs-target="#villageCarousel"
                    data-bs-slide-to="5">
            </button>

            <button type="button"
                    data-bs-target="#villageCarousel"
                    data-bs-slide-to="6">
            </button>

            <button type="button"
                    data-bs-target="#villageCarousel"
                    data-bs-slide-to="7">
            </button>

        </div>

        <!-- Images -->
        <div class="carousel-inner">

            <!-- IMAGE 1 -->
            <div class="carousel-item active">
                <img src="~/images/v1.jpg"
                     class="d-block w-100 gallery-img"
                     onclick="openImage(this.src)" />
            </div>

            <!-- IMAGE 2 -->
            <div class="carousel-item">
                <img src="~/images/bmk.jpg"
                     class="d-block w-100 gallery-img"
                     onclick="openImage(this.src)" />
            </div>

            <!-- IMAGE 3 -->
            <div class="carousel-item">
                <img src="~/images/dattMandir.jpg"
                     class="d-block w-100 gallery-img"
                     onclick="openImage(this.src)" />
            </div>

            <!-- IMAGE 4 -->
            <div class="carousel-item">
                <img src="~/images/ghatamabai.jpg"
                     class="d-block w-100 gallery-img"
                     onclick="openImage(this.src)" />
            </div>

            <!-- IMAGE 5 -->
            <div class="carousel-item">
                <img src="~/images/karkhana.jpg"
                     class="d-block w-100 gallery-img"
                     onclick="openImage(this.src)" />
            </div>

            <!-- IMAGE 6 -->
            <div class="carousel-item">
                <img src="~/images/River.jpg"
                     class="d-block w-100 gallery-img"
                     onclick="openImage(this.src)" />
            </div>

            <!-- IMAGE 7 -->
            <div class="carousel-item">
                <img src="~/images/view.jpg"
                     class="d-block w-100 gallery-img"
                     onclick="openImage(this.src)" />
            </div>

            <!-- IMAGE 8 -->
            <div class="carousel-item">
                <img src="~/images/gram.jpg"
                     class="d-block w-100 gallery-img"
                     onclick="openImage(this.src)" />
            </div>

        </div>

        <!-- PREVIOUS BUTTON -->
        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#villageCarousel"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"></span>
        </button>

        <!-- NEXT BUTTON -->
        <button class="carousel-control-next"
                type="button"
                data-bs-target="#villageCarousel"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"></span>
        </button>

    </div>
</div>

<!-- IMAGE ZOOM MODAL -->
<div class="modal fade" id="imageModal" tabindex="-1">

    <div class="modal-dialog modal-dialog-centered modal-xl">

        <div class="modal-content bg-dark border-0">

            <div class="modal-body text-center p-2">

                <img id="modalImage"
                     src=""
                     class="img-fluid rounded shadow" />

            </div>

        </div>

    </div>

</div>

<style>

    .gallery-img {
        height: 500px;
        object-fit: cover;
        cursor: pointer;
        transition: transform 0.3s ease;
    }

    .gallery-img:hover {
        transform: scale(1.02);
    }

    .carousel-item img {
        border-radius: 12px;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0,0,0,0.5);
        border-radius: 50%;
        padding: 20px;
    }

    .carousel-indicators button {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

</style>

<script>

    function openImage(src) {

        document.getElementById("modalImage").src = src;

        var myModal = new bootstrap.Modal(
            document.getElementById('imageModal')
        );

        myModal.show();
    }

</script>