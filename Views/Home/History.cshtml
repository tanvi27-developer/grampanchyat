@{
    ViewData["Title"] = "Village History";
}

<h2 class="text-center text-primary mb-5">🏛 Village History Timeline</h2>

<div class="timeline">

    <div class="timeline-item">
        <div class="timeline-year">1990</div>
        <div class="timeline-content">
            <h5>🌱 Village Established</h5>
            <p>Our village was officially established with basic infrastructure and small population.</p>
        </div>
    </div>

    <div class="timeline-item">
        <div class="timeline-year">2000</div>
        <div class="timeline-content">
            <h5>🏫 School Development</h5>
            <p>Primary and secondary schools were developed to improve education.</p>
        </div>
    </div>

    <div class="timeline-item">
        <div class="timeline-year">2010</div>
        <div class="timeline-content">
            <h5>🚰 Water & Roads</h5>
            <p>Roads and water supply systems were improved under government schemes.</p>
        </div>
    </div>

    <div class="timeline-item">
        <div class="timeline-year">2020</div>
        <div class="timeline-content">
            <h5>💻 Digital Gram Panchayat</h5>
            <p>Introduction of online services like certificates and tax systems.</p>
        </div>
    </div>

    <div class="timeline-item">
        <div class="timeline-year">2025</div>
        <div class="timeline-content">
            <h5>🚀 Smart Village Initiative</h5>
            <p>Smart governance, digital records, and citizen-friendly services launched.</p>
        </div>
    </div>

</div>

<style>
.timeline {
    position: relative;
    margin: 40px 0;
    padding-left: 60px;
    border-left: 4px solid #0d6efd;
}

.timeline-item {
    margin-bottom: 40px;
    position: relative;
}

.timeline-item::before {
    content: "";
    position: absolute;
    left: -14px;
    top: 10px;
    width: 22px;
    height: 22px;
    background-color: #0d6efd;
    border-radius: 50%;
    border: 3px solid white;
}

.timeline-year {
    font-size: 20px;
    font-weight: bold;
    color: white;
    background: #0d6efd;
    display: inline-block;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 10px;
}

.timeline-content {
    background: #f8f9fa;
    padding: 18px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}
</style>