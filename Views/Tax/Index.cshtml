@model List<GrampanchayatSystem.Models.TaxRecord>
@{
    ViewData["Title"] = "Tax Records";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Tax System</h2>
    <a asp-controller="Tax" asp-action="Create" class="btn btn-primary">Add Tax Record</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Citizen Name</th>
                    <th>Tax Type</th>
                    <th>Amount</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No tax records available.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CitizenName</td>
                            <td>@item.TaxType</td>
                            <td>@item.Amount.ToString("C")</td>
                            <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.IsPaid)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
